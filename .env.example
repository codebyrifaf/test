# Keep real values in .env or .env.local, never in version control.
# Next.js loads both; .env.local overrides .env. Restart after changing values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only modern Supabase secret; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
ADMIN_PASSWORD=
# Independent random signing secret, at least 32 characters.
ADMIN_SESSION_SECRET=

# Verified defaults; change only to a model available to your key.
GEMINI_MODEL=gemini-3.5-flash-lite
# Backup models in order, comma-separated: used after a transient error
# (5xx/network/timeout), in parallel when the main model is silent for 2.5
# seconds, and to finish an answer that broke off. Empty disables backups.
# Never enable paid-only models implicitly. gemini-3.1-flash-lite is not a
# default backup: in tests it added facts that were not in the memory.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Thinking before answering: minimal (default, fastest), low or medium.
# Tested: low was 2-4x slower to first words and did not improve answers.
GEMINI_THINKING_LEVEL=minimal
# Gemini request budget; respect provider RPM, TPM and daily limits.
GEMINI_REQUESTS_PER_MINUTE=20

# Optional: an email or URL sent to Wikipedia with web lookups. Wikipedia asks
# API clients for contact details and rate-limits anonymous clients sooner.
WEB_SEARCH_CONTACT=

# Optional exact origin, including scheme and port; important behind a proxy.
APP_ORIGIN=
# Enable only when your trusted proxy strips spoofed forwarding headers.
TRUST_PROXY_HEADERS=false
